# ---- Postgres ----
POSTGRES_DB=train
POSTGRES_USER=train
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- GTFS feed ----
GTFS_FEED_ID=mdb-11
GTFS_PRIMARY_URL=https://files.mobilitydatabase.org/mdb-11/latest.zip
GTFS_FALLBACK_URL=https://content.amtrak.com/content/gtfs/GTFS.zip
GTFS_FEED_TZ=America/New_York

# ---- API ----
API_PORT=8080
API_BASE_URL=http://api:8080

# ---- MCP ----
MCP_PORT=8000
MCP_API_BASE_URL=http://api:8080

# ---- CLI (when run outside docker) ----
TRAIN_API_BASE_URL=http://localhost:8080
